# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/

# SQLite side files.  northbound.db itself is NOT ignored - it is the
# project's historical record and calibration dataset.
*.db-journal
*.db-wal
*.db-shm

# Database backups (kept locally, not worth versioning)
backups/

# Supabase credentials.  The sync script reads these from the
# environment only; a local .env must never be committed.
# These patterns have no slash, so they match at any depth - web/.env.local
# is covered too.  .env.example is re-included: it holds only placeholders.
.env
.env.*
!.env.example

# Frontend (web/) tooling and build output
node_modules/
dist/
.vercel/
*.tsbuildinfo

# Local editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Virtual environments
.venv/
venv/
env/
# Local Claude Code settings
.claude/settings.local.json